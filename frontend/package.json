{
  "name": "p100-inference-lab-dashboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "audit:security": "node --test scripts/security-audit.test.mjs && node scripts/security-audit.mjs && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
