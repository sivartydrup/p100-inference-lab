[Unit]
Description=Scream P100 Flash Next two-agent queued 256K profile
ConditionPathExists=%h/inference/scream-flash-next-two-agent/profile.json

[Service]
Type=exec
UMask=0077
NoNewPrivileges=yes
WorkingDirectory=%h/inference/scream-p100
Environment=LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64
UnsetEnvironment=FNX_EXPERT_DYN_GIB FNX_ROPE_SCALE FNX_YARN_ORIG_CTX
ExecStartPre=/bin/sh %h/.config/p100-gateway/gpu-engine-idle.sh %n
ExecStart=/bin/bash %h/inference/scream-p100/run.sh %h/inference/scream-flash-next --config %h/inference/scream-flash-next-two-agent/profile.json --host 127.0.0.1 --port 8088
MemoryMax=84G
MemorySwapMax=0
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=45
